# 운영(EC2)에서 앱에 전달하는 환경변수 목록 (공유용 예시 - 실제 값은 EC2에서만 채운다)
# EC2에 prod.env로 복사해 값을 채우고 `chmod 600 prod.env` 후 아래처럼 읽어 실행한다.
#   set -a; source ~/prod.env; set +a; nohup java -jar ~/movie-app.jar > ~/movie-app.log 2>&1 &
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_HOST=            # RDS 엔드포인트
DB_PORT=3306
DB_NAME=umc_movie
DB_USER=
DB_PASSWORD=
JWT_SECRET=         # 32자 이상 임의 문자열 (로컬과 다른 값)
JWT_ACCESS_EXPIRATION=3600
FRONTEND_ORIGIN=    # 배포된 프론트 주소. 예: https://frontend.example.com
